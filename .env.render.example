NODE_VERSION=20

# Do not set NODE_ENV on Render for this service. Render already runs Node apps
# in production mode, and setting NODE_ENV=production during build can skip
# devDependencies that are required for `nest build`.

DATABASE_URL="postgresql://gathergo_user:Rn4pXQqL177QEGs0iiVxrNy2u94wmb4O@dpg-d77fogc50q8c73cq29eg-a/gathergo"
REDIS_URL=redis://red-d77g2odm5p6s738abb30:6379

JWT_SECRET=replace-with-production-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-different-production-secret-at-least-32-chars

# Keep browser/frontend origins public here. Localhost should stay in `.env.local`.
FRONTEND_URL=https://<your-public-frontend-domain>
# Or, for multiple origins:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=https://<your-render-service>.onrender.com/api/v1/auth/google/redirect

# Paste as raw JSON in the Render dashboard, ideally minified to one line.
FIREBASE_SERVICE_ACCOUNT_JSON=<firebase-service-account-json>
FIREBASE_STORAGE_BUCKET=<firebase-storage-bucket>

MAIL_ENABLED=true
MAIL_PROVIDER=resend
RESEND_API_KEY=<resend-api-key>
RESEND_DEFAULT_FROM=<from-address>

AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_VERIFICATION_CODE_LENGTH=6
AUTH_EMAIL_VERIFICATION_EXPIRY_MINUTES=10
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
MAIL_EMAIL_VERIFICATION_CODE_ENABLED=true
MAIL_TEMPLATE_KEY_EMAIL_VERIFICATION_CODE=<resend-template-id>

MAIL_PASSWORD_RESET_CODE_ENABLED=true
MAIL_TEMPLATE_KEY_PASSWORD_RESET_CODE=<resend-template-id>
AUTH_PASSWORD_RESET_CODE_LENGTH=6
AUTH_PASSWORD_RESET_EXPIRY_MINUTES=10
AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5

# Optional feature integrations. Keep only what you actively use in Render.
# PAYSTACK_SECRET_KEY=
# ALAT_SECRET_KEY=
# ALAT_BANK_TRANSFER_PATH=
# TEMP_BUSINESS_ID=
# QOREID_CLIENT_ID=
# QOREID_CLIENT_SECRET=
# QOREID_WEBHOOK_SECRET=
# QOREID_BASE_URL=
# QOREID_MOCK_MODE=true
# KYC_ENTITY_HASH_SECRET=
# INTERNAL_OPS_KEY=
