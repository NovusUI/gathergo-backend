NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:8081

# Use local services on your laptop, or replace these with Render external URLs
# if you intentionally want local code to connect to Render-managed infrastructure.
DATABASE_URL=postgresql://localhost:5432/gathergo
SHADOW_DATABASE_URL=postgresql://localhost:5432/gathergo_shadow
REDIS_URL=redis://127.0.0.1:6379

# Local-safe fallbacks exist for JWT secrets in non-production, but keeping them
# explicit makes local auth behavior match production more closely.
JWT_SECRET=replace-with-local-dev-secret-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-local-refresh-secret-at-least-16-chars

GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/redirect

# Add any provider secrets you need for the features you are testing locally:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_STORAGE_BUCKET=
# RESEND_API_KEY=
# RESEND_DEFAULT_FROM=
# PAYSTACK_SECRET_KEY=
# QOREID_CLIENT_ID=
# QOREID_CLIENT_SECRET=
# QOREID_WEBHOOK_SECRET=
# QOREID_BASE_URL=
# KYC_ENTITY_HASH_SECRET=
# INTERNAL_OPS_KEY=
