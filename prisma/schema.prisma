generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  username              String?                @unique
  password              String?
  createdAt             DateTime               @default(now())
  bio                   String?
  birthDate             DateTime?
  googleId              String?                @unique
  hasPreferences        Boolean                @default(false)
  isProfileComplete     Boolean                @default(false)
  nationality           String?
  profilePicUrl         String?
  updatedAt             DateTime?              @updatedAt
  gender                Gender?
  phoneNumber           String?
  resetToken            String?
  resetTokenExpiry      DateTime?
  isVerified            Boolean                @default(false)
  fullName              String?
  profilePicUrlTN       String?
  Carpool               Carpool[]
  CarpoolPassenger      CarpoolPassenger[]
  Comment               Comment[]
  communities           Community[]
  communityFollows      CommunityFollow[]
  DeviceToken           DeviceToken[]
  eventsCreated         Event[]                @relation("UserEvents")
  Like                  Like[]
  Message               Message[]
  receivedNotifications Notification[]         @relation("NotificationRecipient")
  sentNotifications     Notification[]         @relation("NotificationSender")
  Post                  Post[]
  Registration          Registration[]
  Ticket                Ticket[]
  Donation              Donation[]
  TransactionReference  TransactionReference[]
  following             UserFollow[]           @relation("Follower")
  followedBy            UserFollow[]           @relation("Following")
  preference            UserPreference?
  commentsMentioned     Comment[]              @relation("CommentMentions")
  readMessages          Message[]              @relation("MessageReadBy")
  postsMentions         Post[]                 @relation("PostMentions")
  refreshTokens         RefreshToken[]
  feeds                 Feed[]
  hiddenFeeds           HiddenFeed[]
  scannerPermissions    ScannerPermission[]    @relation("ScannerPermissions")
  grantedPermissions    ScannerPermission[]    @relation("PermissionOwner")
  scanLogs              ScanLog[]
}

model UserPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  eventTypes   String[]
  interests    String[]
  location     String?
  primaryUsage String?
  user         User     @relation(fields: [userId], references: [id])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Community {
  id               String            @id @default(uuid())
  name             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  bannerUrl        String?
  description      String?
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  communityFollows CommunityFollow[]
  events           Event[]           @relation("CommunityEvents")
  Post             Post[]
}

model CommunityFollow {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
}

model Event {
  id                    String           @id @default(uuid())
  title                 String
  description           String?
  imageUrl              String?
  location              String?
  links                 String[]
  startDate             DateTime
  endDate               DateTime
  reoccurring           Reoccurring      @default(NONE)
  communityId           String?
  creatorId             String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tags                  String[]
  endRepeat             DateTime?
  registrationAttendees Int?
  registrationFee       Int?
  donationTarget        Int?
  thumbnailUrl          String?
  registrationType      RegistrationType
  carpools              Carpool[]
  community             Community?       @relation("CommunityEvents", fields: [communityId], references: [id])
  creator               User             @relation("UserEvents", fields: [creatorId], references: [id])
  eventTickets          EventTicket[]
  donations             Donation[]
  EventTrend            EventTrend?
  Post                  Post[]
  Registration          Registration[]
  isImageProcessing     Boolean          @default(false)
  feeds                 Feed[]

  transactions       TransactionReference[]

  scanLogs           ScanLog[]
}

model EventTicket {
  id           String   @id @default(uuid())
  eventId      String
  type         String
  description  String
  price        Float
  quantity     Int
  sold         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  perks        String[]
  isVisible    Boolean  @default(true)
  updatedPrice Float?
  event        Event    @relation(fields: [eventId], references: [id])
  tickets      Ticket[]
}

model Ticket {
  id            String      @id @default(uuid())
  userId        String
  eventTicketId String
  status        String      @default("active")
  createdAt     DateTime    @default(now())
  qrCode        String      @unique
  isUsed        Boolean     @default(false)
  transactionId String
  eventTicket   EventTicket @relation(fields: [eventTicketId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  scannedAt     DateTime?
  scannedBy     String?
  scanLocation  String?
  ScanLog       ScanLog[]
}

model Registration {
  id            String    @id @default(uuid())
  userId        String
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  qrCode        String    @unique
  isUsed        Boolean   @default(false)
  transactionId String
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  scannedAt     DateTime?
  scannedBy     String?
  scanLocation  String?
  ScanLog       ScanLog[]
}

model Donation {
  id            String   @id @default(uuid())
  userId        String
  amount        Int // Amount donated in kobo (₦50,000 = 5000000)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  transactionId String
  eventId       String
  message       String? // Optional message from donor
  isAnonymous   Boolean  @default(false) // Whether donor wants to be anonymous
  event         Event    @relation(fields: [eventId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([transactionId])
}

model TransactionReference {
  id        String                @id @default(uuid())
  userId    String
  amount    Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  metadata  Json
  status    TransactionStatusType @default(PENDING)
  user      User                  @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?                @relation(fields: [eventId], references: [id])
}

model Carpool {
  id             String                                @id @default(uuid())
  driverId       String
  eventId        String?
  origin         String
  destination    String?
  departureTime  String
  availableSeats Int                                   @default(3)
  pricePerSeat   Float                                 @default(0)
  description    String?
  status         String                                @default("ACTIVE")
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  isDeleted      Boolean                               @default(false)
  startPoint     Unsupported("geometry(Point, 4326)")?
  endPoint       Unsupported("geometry(Point, 4326)")?
  expiresAt      DateTime                              @default(now())
  note           String?
  driver         User                                  @relation(fields: [driverId], references: [id])
  event          Event?                                @relation(fields: [eventId], references: [id])
  passengers     CarpoolPassenger[]
  Message        Message[]
}

model CarpoolPassenger {
  id                String                                @id @default(uuid())
  userId            String
  carpoolId         String
  status            String                                @default("PENDING")
  origin            String
  startPoint        Unsupported("geometry(Point, 4326)")?
  note              String?
  joinedAt          DateTime?
  requestedAt       DateTime                              @default(now())
  updatedAt         DateTime?
  carpool           Carpool                               @relation(fields: [carpoolId], references: [id])
  user              User                                  @relation(fields: [userId], references: [id])
  estimatedDistance String?
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  link        String?
  recipientId String
  senderId    String?
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id])
  variant     String?

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
  @@index([read])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  tempId    String?
  carpoolId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  carpool   Carpool  @relation(fields: [carpoolId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
  readBy    User[]   @relation("MessageReadBy")
}

model Post {
  id            String     @id @default(cuid())
  creatorId     String
  eventId       String?
  communityId   String?
  type          PostType
  content       String?
  mediaUrls     String[]
  pollOptions   String[]
  isPinned      Boolean    @default(false)
  isSystem      Boolean    @default(false)
  allowComments Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  comments      Comment[]
  likes         Like[]
  community     Community? @relation(fields: [communityId], references: [id])
  creator       User       @relation(fields: [creatorId], references: [id])
  event         Event?     @relation(fields: [eventId], references: [id])
  hashtags      Hashtag[]  @relation("PostHashtags")
  mentions      User[]     @relation("PostMentions")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  mentions  User[]   @relation("CommentMentions")
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Hashtag {
  id         String @id @default(cuid())
  tag        String @unique
  trendScore Int    @default(0)
  posts      Post[] @relation("PostHashtags")
}

model EventTrend {
  eventId    String @id
  trendScore Int    @default(0)
  event      Event  @relation(fields: [eventId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationType {
  ticket
  registration
  donation
}

enum TransactionStatusType {
  SUCCESS
  PENDING
  FAILED
}

enum Reoccurring {
  NONE
  DAILY
  WEEKLY
}

enum PostType {
  TEXT
  IMAGE
  POLL
  SYSTEM
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Feed {
  id       String       @id @default(cuid())
  eventId  String
  type     String // FeedType enum
  title    String
  content  String?
  userId   String?
  metadata Json         @default("{}")
  actions  Json         @default("[]")
  isPinned Boolean      @default(false)
  pinOrder Int          @default(4) // 0 = highest priority
  isHidden HiddenFeed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([eventId, createdAt])
  @@index([eventId, isPinned, pinOrder])
  @@index([eventId, type, isPinned])
  @@index([userId, isPinned])
  @@index([createdAt])
}

model HiddenFeed {
  userId   String
  feedId   String
  hiddenAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  // Composite primary key
  @@id([userId, feedId])
  // Indexes
  @@index([userId])
  @@index([feedId])
}

// Add to your existing schema


model ScannerPermission {
  id        String    @id @default(uuid())
  ownerId   String    // Event owner who granted permission
  scannerId String    // User who can scan
  createdAt DateTime  @default(now())
  expiresAt DateTime? // Optional expiration
  isActive  Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  // Relations
  owner   User   @relation("PermissionOwner", fields: [ownerId], references: [id])
  scanner User   @relation("ScannerPermissions", fields: [scannerId], references: [id])
  

  // Unique constraint: an owner can grant permission to a scanner only once
  @@unique([ownerId, scannerId])
}


model ScanLog {
  id             String   @id @default(uuid())
  type           String // 'ticket' | 'registration' | 'validation'
  qrCode         String
  scannedById    String // User who performed the scan
  eventId        String?
  ticketId       String?
  registrationId String?
  action         String // 'validated' | 'marked_used' | 'checked_in'
  success        Boolean
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())

  // Relations - no need for duplicate user reference
  event        Event?        @relation(fields: [eventId], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  scannedBy    User          @relation(fields: [scannedById], references: [id])

  @@index([qrCode])
  @@index([scannedById])
  @@index([createdAt])
}
