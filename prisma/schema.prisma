generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum DashboardRole {
  USER
  ADMIN
}

enum DashboardAccountStatus {
  ACTIVE
  DISABLED
}

model DashboardUser {
  id                  String                 @id @default(uuid())
  username            String                 @unique
  fullName            String
  passwordHash        String
  role                DashboardRole          @default(USER)
  status              DashboardAccountStatus @default(ACTIVE)
  mustChangePassword  Boolean                @default(true)
  failedLoginAttempts Int                    @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdById         String?
  createdBy           DashboardUser?         @relation("DashboardAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAccounts     DashboardUser[]        @relation("DashboardAccountCreator")
  sessions            DashboardSession[]

  @@index([role, status])
}

model DashboardSession {
  id        String        @id @default(uuid())
  tokenHash String        @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime      @default(now())
  user      DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model User {
  id                          String                    @id @default(uuid())
  email                       String                    @unique
  username                    String?                   @unique
  password                    String?
  createdAt                   DateTime                  @default(now())
  bio                         String?
  birthDate                   DateTime?
  googleId                    String?                   @unique
  hasPreferences              Boolean                   @default(false)
  isProfileComplete           Boolean                   @default(false)
  nationality                 String?
  profilePicUrl               String?
  updatedAt                   DateTime?                 @updatedAt
  gender                      Gender?
  phoneNumber                 String?
  resetToken                  String?
  resetTokenExpiry            DateTime?
  resetTokenSentAt            DateTime?
  resetTokenAttempts          Int                       @default(0)
  emailVerificationCodeHash   String?
  emailVerificationCodeExpiry DateTime?
  emailVerificationSentAt     DateTime?
  emailVerificationAttempts   Int                       @default(0)
  isVerified                  Boolean                   @default(false)
  fullName                    String?
  profilePicUrlTN             String?
  Carpool                     Carpool[]
  CarpoolPassenger            CarpoolPassenger[]
  Comment                     Comment[]
  communities                 Community[]
  communityFollows            CommunityFollow[]
  DeviceToken                 DeviceToken[]
  eventsCreated               Event[]                   @relation("UserEvents")
  Like                        Like[]
  Message                     Message[]
  receivedNotifications       Notification[]            @relation("NotificationRecipient")
  sentNotifications           Notification[]            @relation("NotificationSender")
  Post                        Post[]
  Registration                Registration[]
  Ticket                      Ticket[]
  mealPasses                  MealPass[]
  Donation                    Donation[]
  buyerTransactions           TransactionReference[]    @relation("BuyerTransactions")
  creatorTransactions         TransactionReference[]    @relation("CreatorTransactions")
  following                   UserFollow[]              @relation("Follower")
  followedBy                  UserFollow[]              @relation("Following")
  preference                  UserPreference?
  commentsMentioned           Comment[]                 @relation("CommentMentions")
  readMessages                Message[]                 @relation("MessageReadBy")
  postsMentions               Post[]                    @relation("PostMentions")
  refreshTokens               RefreshToken[]
  feeds                       Feed[]
  hiddenFeeds                 HiddenFeed[]
  scannerPermissions          ScannerPermission[]       @relation("ScannerPermissions")
  grantedPermissions          ScannerPermission[]       @relation("PermissionOwner")
  scanLogs                    ScanLog[]
  settlementProfile           CreatorSettlementProfile?
  alatProfile                 CreatorAlatProfile?
  kycVerification             CreatorKycVerification?
  settlementAccountChanges    SettlementAccountChange[]
  settlementRecords           SettlementRecord[]
  impactReports               EventImpactReport[]
  volunteerApplications       EventVolunteer[]          @relation("VolunteerUser")
  confirmedVolunteerWork      EventVolunteer[]          @relation("VolunteerConfirmer")
  badges                      UserBadge[]
}

enum BadgeCode {
  FIRST_GATHER
  FAMILIAR_FACE
  HELPING_HAND
  TIME_GIVER
  GATHER_MAKER
  IMPACT_STORYTELLER
  FIRST_GIFT
  COMMUNITY_BACKER
  STEADY_GIVER
}

model UserBadge {
  userId   String
  code     BadgeCode
  earnedAt DateTime?
  isPublic Boolean   @default(false)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

model UserPreference {
  id              String           @id @default(uuid())
  userId          String           @unique
  eventTypes      String[]
  interests       String[]
  location        String?
  primaryUsage    String?
  helpModes       String[]         @default([])
  learningEnabled Boolean          @default(true)
  learningSince   DateTime         @default(now())
  signals         InterestSignal[]
  eventFeedback   EventFeedback[]
  user            User             @relation(fields: [userId], references: [id])
}

model InterestSignal {
  id           String             @id @default(uuid())
  preferenceId String
  eventId      String
  kind         InterestSignalKind
  createdAt    DateTime           @default(now())
  preference   UserPreference     @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, eventId, kind])
  @@index([preferenceId, createdAt])
}

enum InterestSignalKind {
  LIKE
  VIEW
}

enum EventFeedbackRating {
  LOVED
  OKAY
  NOT_FOR_ME
}

model EventFeedback {
  id            String               @id @default(uuid())
  preferenceId  String
  eventId       String
  rating        EventFeedbackRating?
  moreLikeThis  Boolean              @default(false)
  respondedAt   DateTime?
  deferredUntil DateTime?
  preference    UserPreference       @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, eventId])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Community {
  id               String            @id @default(uuid())
  name             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  bannerUrl        String?
  description      String?
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  communityFollows CommunityFollow[]
  events           Event[]           @relation("CommunityEvents")
  Post             Post[]
}

model CommunityFollow {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
}

enum FoodBankCollectionStatus {
  NOT_STARTED
  OPEN
  PAUSED
  CLOSED
}

model Event {
  id                    String             @id @default(uuid())
  title                 String
  description           String?
  impactTitle           String?
  impactDescription     String?
  impactPercentage      Int?
  impactSdgGoals        Json?
  impactPaths           Json?
  impactCommitments     Json?
  impactMapSource       String?
  impactMapGeneratedAt  DateTime?
  isPhysicalEvent       Boolean            @default(true)
  imageUrl              String?
  location              String?
  links                 String[]
  startDate             DateTime
  endDate               DateTime
  reoccurring           Reoccurring        @default(NONE)
  communityId           String?
  creatorId             String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tags                  String[]
  endRepeat             DateTime?
  registrationAttendees Int?
  registrationFee       Int?
  donationTarget        Int?
  donationsEnabled      Boolean            @default(false)
  impactMapSentAt       DateTime?
  thumbnailUrl          String?
  foodBankTotalMeals    Int?
  foodBankSlotCapacity  Int?
  foodBankSlotMinutes   Int?
  foodBankCollectionStatus FoodBankCollectionStatus @default(NOT_STARTED)
  foodBankTimeZone       String @default("Africa/Lagos")
  mealPasses            MealPass[]
  registrationType      RegistrationType
  carpools              Carpool[]
  community             Community?         @relation("CommunityEvents", fields: [communityId], references: [id])
  creator               User               @relation("UserEvents", fields: [creatorId], references: [id])
  eventTickets          EventTicket[]
  donations             Donation[]
  EventTrend            EventTrend?
  Post                  Post[]
  Registration          Registration[]
  isImageProcessing     Boolean            @default(false)
  feeds                 Feed[]
  impactReport          EventImpactReport?
  volunteerRoles        VolunteerRole[]
  volunteers            EventVolunteer[]
  interestSignals       InterestSignal[]
  feedback              EventFeedback[]

  transactions TransactionReference[]

  scanLogs ScanLog[]
}

model VolunteerRole {
  id               String           @id @default(uuid())
  eventId          String
  title            String
  description      String
  capacity         Int
  requiresApproval Boolean          @default(true)
  isOpen           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  applications     EventVolunteer[]

  @@unique([id, eventId])
  @@index([eventId])
}

model EventVolunteer {
  id               String          @id @default(uuid())
  eventId          String
  roleId           String
  userId           String
  status           VolunteerStatus @default(APPLIED)
  note             String?
  checkedInAt      DateTime?
  completedAt      DateTime?
  confirmedMinutes Int?
  confirmedById    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role             VolunteerRole   @relation(fields: [roleId, eventId], references: [id, eventId], onDelete: Cascade)
  user             User            @relation("VolunteerUser", fields: [userId], references: [id])
  confirmedBy      User?           @relation("VolunteerConfirmer", fields: [confirmedById], references: [id])

  @@unique([eventId, userId])
  @@index([roleId, status])
  @@index([userId, status])
}

enum VolunteerStatus {
  APPLIED
  ACCEPTED
  DECLINED
  WITHDRAWN
  CHECKED_IN
  COMPLETED
}

model EventImpactReport {
  id            String             @id @default(uuid())
  eventId       String             @unique
  creatorId     String
  summary       String
  outcomes      Json               @default("[]")
  evidenceLinks String[]
  status        ImpactReportStatus @default(PUBLISHED)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator       User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status])
  @@index([publishedAt])
}

model EventTicket {
  id               String                    @id @default(uuid())
  eventId          String
  type             String
  description      String
  price            Float
  quantity         Int
  sold             Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  perks            String[]
  isVisible        Boolean                   @default(true)
  updatedPrice     Float?
  event            Event                     @relation(fields: [eventId], references: [id])
  tickets          Ticket[]
  reservationItems CheckoutReservationItem[]
}

model Ticket {
  id             String      @id @default(uuid())
  userId         String
  eventTicketId  String
  status         String      @default("active")
  createdAt      DateTime    @default(now())
  qrCode         String      @unique
  isUsed         Boolean     @default(false)
  transactionId  String
  fulfillmentKey String?     @unique
  eventTicket    EventTicket @relation(fields: [eventTicketId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  scannedAt      DateTime?
  scannedBy      String?
  scanLocation   String?
  ScanLog        ScanLog[]

  @@index([transactionId])
  @@index([eventTicketId, status])
}

model Registration {
  id             String    @id @default(uuid())
  userId         String
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  qrCode         String    @unique
  isUsed         Boolean   @default(false)
  transactionId  String
  fulfillmentKey String?   @unique
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  scannedAt      DateTime?
  scannedBy      String?
  scanLocation   String?
  ScanLog        ScanLog[]

  @@index([transactionId])
  @@index([eventId, userId, status])
}

model MealPass {
  id              String   @id @default(uuid())
  userId          String
  eventId         String
  qrCode          String   @unique
  collectionStart DateTime
  collectionEnd   DateTime
  isUsed          Boolean  @default(false)
  collectedAt     DateTime?
  collectedBy     String?
  createdAt       DateTime @default(now())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, collectionStart])
  @@index([userId])
}

model Donation {
  id            String   @id @default(uuid())
  userId        String
  amount        Int // Amount donated in kobo (₦50,000 = 5000000)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  transactionId String
  eventId       String
  message       String? // Optional message from donor
  isAnonymous   Boolean  @default(false) // Whether donor wants to be anonymous
  event         Event    @relation(fields: [eventId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([transactionId])
}

model TransactionReference {
  id                      String                       @id @default(uuid())
  userId                  String
  creatorId               String?
  amount                  Int
  platformFee             Int                          @default(0)
  providerFee             Int                          @default(0)
  creatorPayable          Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  metadata                Json
  riskReasons             Json                         @default("[]")
  status                  TransactionStatusType        @default(PENDING)
  paymentProvider         PaymentProvider              @default(PAYSTACK)
  paymentType             PaymentType?
  settlementStatus        SettlementStatus             @default(NOT_READY)
  riskStatus              RiskStatus                   @default(CLEAR)
  riskScore               Int                          @default(0)
  providerReference       String?
  providerPayload         Json?
  fulfilledAt             DateTime?
  idempotencyKey          String?
  requestHash             String?
  paymentUrl              String?
  initializationStatus    CheckoutInitializationStatus @default(NOT_STARTED)
  initializationStartedAt DateTime?
  settledAt               DateTime?
  reviewedAt              DateTime?
  user                    User                         @relation("BuyerTransactions", fields: [userId], references: [id])
  creator                 User?                        @relation("CreatorTransactions", fields: [creatorId], references: [id])
  eventId                 String?
  event                   Event?                       @relation(fields: [eventId], references: [id])
  settlementAllocations   SettlementAllocation[]
  webhookEvents           ProviderWebhookEvent[]
  reservation             CheckoutReservation?
  refund                  CheckoutRefund?
  fulfillmentJob          CheckoutFulfillmentJob?

  @@unique([userId, idempotencyKey])
  @@index([eventId, status])
  @@index([creatorId, status])
  @@index([creatorId, settlementStatus])
  @@index([paymentProvider, status])
  @@index([riskStatus])
}

model CreatorSettlementProfile {
  id                       String                         @id @default(uuid())
  userId                   String                         @unique
  legalName                String?
  businessName             String?
  status                   CreatorSettlementProfileStatus @default(NOT_STARTED)
  accountOwnershipType     AccountOwnershipType           @default(UNKNOWN)
  bankName                 String?
  bankCode                 String?
  accountNumber            String?
  accountNumberMasked      String?
  accountName              String?
  bvnLast4                 String?
  accountVerifiedAt        DateTime?
  kycStatus                KycVerificationStatus          @default(NOT_STARTED)
  nameMatchStatus          NameMatchStatus                @default(NOT_CHECKED)
  metadata                 Json                           @default("{}")
  submittedAt              DateTime?
  approvedAt               DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  user                     User                           @relation(fields: [userId], references: [id])
  kycVerification          CreatorKycVerification?
  settlementAccountChanges SettlementAccountChange[]
}

model CreatorAlatProfile {
  id                  String                   @id @default(uuid())
  userId              String                   @unique
  status              CreatorAlatProfileStatus @default(NOT_STARTED)
  displayName         String?
  businessId          String?
  subaccountReference String?
  accountNumber       String?
  accountName         String?
  activatedAt         DateTime?
  deactivatedAt       DateTime?
  reviewedAt          DateTime?
  notes               String?
  metadata            Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id])
}

model CreatorKycVerification {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  settlementProfileId     String                   @unique
  provider                VerificationProvider     @default(QOREID)
  status                  KycVerificationStatus    @default(NOT_STARTED)
  accountOwnershipType    AccountOwnershipType     @default(UNKNOWN)
  verificationMode        String?
  phoneNumber             String?
  identityType            String?
  identityReferenceMasked String?
  identityReferenceLast4  String?
  providerSubjectHash     String?
  providerSubjectLast4    String?
  businessReferenceHash   String?
  businessReferenceLast4  String?
  nameDobHash             String?
  verifiedFullName        String?
  verifiedBusinessName    String?
  verifiedDateOfBirth     DateTime?
  qoreIdentityCheckId     String?
  qoreBusinessCheckId     String?
  qoreLivenessCheckId     String?
  qoreAmlCheckId          String?
  businessStatus          KycVerificationStatus    @default(NOT_STARTED)
  identityStatus          KycVerificationStatus    @default(NOT_STARTED)
  livenessStatus          KycVerificationStatus    @default(NOT_STARTED)
  amlStatus               KycVerificationStatus    @default(NOT_STARTED)
  dedupStatus             KycVerificationStatus    @default(NOT_STARTED)
  nameMatchStatus         NameMatchStatus          @default(NOT_CHECKED)
  nameMatchScore          Float?
  nameMatchReason         String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  rejectionReason         String?
  metadata                Json                     @default("{}")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id])
  settlementProfile       CreatorSettlementProfile @relation(fields: [settlementProfileId], references: [id])

  @@index([providerSubjectHash])
  @@index([businessReferenceHash])
  @@index([nameDobHash])
}

model SettlementAccountChange {
  id                          String                   @id @default(uuid())
  userId                      String
  settlementProfileId         String
  previousBankName            String?
  previousBankCode            String?
  previousAccountNumberMasked String?
  previousAccountName         String?
  previousOwnershipType       AccountOwnershipType?
  newBankName                 String?
  newBankCode                 String?
  newAccountNumberMasked      String?
  newAccountName              String?
  newOwnershipType            AccountOwnershipType?
  nameChanged                 Boolean                  @default(false)
  ownershipTypeChanged        Boolean                  @default(false)
  requiresReview              Boolean                  @default(true)
  changedBy                   String
  reason                      String?
  metadata                    Json                     @default("{}")
  createdAt                   DateTime                 @default(now())
  user                        User                     @relation(fields: [userId], references: [id])
  settlementProfile           CreatorSettlementProfile @relation(fields: [settlementProfileId], references: [id])

  @@index([userId, createdAt])
}

model SettlementRecord {
  id                       String                 @id @default(uuid())
  creatorId                String
  amount                   Int
  status                   SettlementRecordStatus @default(PENDING)
  reference                String                 @unique
  destinationBankName      String?
  destinationAccountNumber String?
  destinationAccountName   String?
  metadata                 Json                   @default("{}")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  processedAt              DateTime?
  creator                  User                   @relation(fields: [creatorId], references: [id])
  allocations              SettlementAllocation[]

  @@index([creatorId, status])
}

model SettlementAllocation {
  id                     String               @id @default(uuid())
  settlementId           String
  transactionReferenceId String               @unique
  amount                 Int
  createdAt              DateTime             @default(now())
  settlement             SettlementRecord     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  transactionReference   TransactionReference @relation(fields: [transactionReferenceId], references: [id])

  @@index([settlementId])
}

model ProviderWebhookEvent {
  id                     String                @id @default(cuid())
  provider               PaymentProvider
  eventKey               String                @unique
  transactionReferenceId String?
  payload                Json
  createdAt              DateTime              @default(now())
  processedAt            DateTime?
  attempts               Int                   @default(0)
  lastError              String?
  transactionReference   TransactionReference? @relation(fields: [transactionReferenceId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
}

model CheckoutReservation {
  transactionId String                    @id
  status        ReservationStatus         @default(HELD)
  expiresAt     DateTime
  transaction   TransactionReference      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  items         CheckoutReservationItem[]

  @@index([status, expiresAt])
}

model CheckoutReservationItem {
  id            String              @id @default(uuid())
  reservationId String
  eventTicketId String
  quantity      Int
  reservation   CheckoutReservation @relation(fields: [reservationId], references: [transactionId], onDelete: Cascade)
  eventTicket   EventTicket         @relation(fields: [eventTicketId], references: [id])

  @@unique([reservationId, eventTicketId])
  @@index([eventTicketId])
}

model CheckoutRefund {
  transactionId         String               @id
  amountKobo            Int
  reason                String
  status                CheckoutRefundStatus @default(REQUESTED)
  providerTransactionId String?
  providerRefundId      Int?
  attempts              Int                  @default(0)
  nextAttemptAt         DateTime             @default(now())
  leaseExpiresAt        DateTime?
  lastError             String?
  confirmedReference    String?
  confirmedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  transaction           TransactionReference @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model CheckoutFulfillmentJob {
  transactionId  String               @id
  status         CheckoutJobStatus    @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  leaseExpiresAt DateTime?
  lastError      String?
  transaction    TransactionReference @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

enum ReservationStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum CheckoutInitializationStatus {
  NOT_STARTED
  INITIALIZING
  READY
  FAILED
}

enum CheckoutRefundStatus {
  REQUESTED
  PROCESSING
  REFUNDED
  MANUAL_REQUIRED
}

enum CheckoutJobStatus {
  PENDING
  PROCESSING
  COMPLETED
}

model Carpool {
  id             String                                @id @default(uuid())
  driverId       String
  eventId        String?
  origin         String
  destination    String?
  departureTime  String
  availableSeats Int                                   @default(3)
  pricePerSeat   Float                                 @default(0)
  description    String?
  vehicleIcon    String?
  status         String                                @default("ACTIVE")
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  isDeleted      Boolean                               @default(false)
  startPoint     Unsupported("geometry(Point, 4326)")?
  endPoint       Unsupported("geometry(Point, 4326)")?
  expiresAt      DateTime                              @default(now())
  note           String?
  driver         User                                  @relation(fields: [driverId], references: [id])
  event          Event?                                @relation(fields: [eventId], references: [id])
  passengers     CarpoolPassenger[]
  Message        Message[]
}

model CarpoolPassenger {
  id                String                                @id @default(uuid())
  userId            String
  carpoolId         String
  status            String                                @default("PENDING")
  origin            String
  startPoint        Unsupported("geometry(Point, 4326)")?
  note              String?
  joinedAt          DateTime?
  requestedAt       DateTime                              @default(now())
  updatedAt         DateTime?
  carpool           Carpool                               @relation(fields: [carpoolId], references: [id])
  user              User                                  @relation(fields: [userId], references: [id])
  estimatedDistance String?
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  link        String?
  recipientId String
  senderId    String?
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id])
  variant     String?

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
  @@index([read])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  tempId    String?
  carpoolId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  carpool   Carpool  @relation(fields: [carpoolId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
  readBy    User[]   @relation("MessageReadBy")
}

model Post {
  id            String     @id @default(cuid())
  creatorId     String
  eventId       String?
  communityId   String?
  type          PostType
  content       String?
  mediaUrls     String[]
  pollOptions   String[]
  isPinned      Boolean    @default(false)
  isSystem      Boolean    @default(false)
  allowComments Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  comments      Comment[]
  likes         Like[]
  community     Community? @relation(fields: [communityId], references: [id])
  creator       User       @relation(fields: [creatorId], references: [id])
  event         Event?     @relation(fields: [eventId], references: [id])
  hashtags      Hashtag[]  @relation("PostHashtags")
  mentions      User[]     @relation("PostMentions")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  mentions  User[]   @relation("CommentMentions")
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Hashtag {
  id         String @id @default(cuid())
  tag        String @unique
  trendScore Int    @default(0)
  posts      Post[] @relation("PostHashtags")
}

model EventTrend {
  eventId    String @id
  trendScore Int    @default(0)
  event      Event  @relation(fields: [eventId], references: [id])
}

