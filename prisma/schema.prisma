model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Feed {
  id       String       @id @default(cuid())
  eventId  String
  type     String // FeedType enum
  title    String
  content  String?
  userId   String?
  metadata Json         @default("{}")
  actions  Json         @default("[]")
  isPinned Boolean      @default(false)
  pinOrder Int          @default(4) // 0 = highest priority
  isHidden HiddenFeed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([eventId, createdAt])
  @@index([eventId, isPinned, pinOrder])
  @@index([eventId, type, isPinned])
  @@index([userId, isPinned])
  @@index([createdAt])
}

model HiddenFeed {
  userId   String
  feedId   String
  hiddenAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  // Composite primary key
  @@id([userId, feedId])
  // Indexes
  @@index([userId])
  @@index([feedId])
}

// Add to your existing schema

model ScannerPermission {
  id        String    @id @default(uuid())
  ownerId   String // Event owner who granted permission
  scannerId String // User who can scan
  createdAt DateTime  @default(now())
  expiresAt DateTime? // Optional expiration
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  // Relations
  owner     User      @relation("PermissionOwner", fields: [ownerId], references: [id])
  scanner   User      @relation("ScannerPermissions", fields: [scannerId], references: [id])

  // Unique constraint: an owner can grant permission to a scanner only once
  @@unique([ownerId, scannerId])
}

model ScanLog {
  id             String   @id @default(uuid())
  type           String // 'ticket' | 'registration' | 'validation'
  qrCode         String
  scannedById    String // User who performed the scan
  eventId        String?
  ticketId       String?
  registrationId String?
  action         String // 'validated' | 'marked_used' | 'checked_in'
  success        Boolean
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())

  // Relations - no need for duplicate user reference
  event        Event?        @relation(fields: [eventId], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  scannedBy    User          @relation(fields: [scannedById], references: [id])

  @@index([qrCode])
  @@index([scannedById])
  @@index([createdAt])
}

enum ShortLinkKind {
  event
  foodbank
  carpool
}

model ShortLink {
  code      String        @id
  kind      ShortLinkKind
  targetId  String
  createdAt DateTime      @default(now())

  @@unique([kind, targetId])
}
